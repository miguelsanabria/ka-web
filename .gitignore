# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# datos locales de desarrollo
server/data
/data/
data/
server/node_modules/
*.log
tailwindcss*.log
tunnel/
out/

# snapshot consistente de la DB que genera el contenedor db-snapshot
/.snapshot/

# python
__pycache__/
*.pyc
